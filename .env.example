# Canonical classroom settings. Copy to .env (untracked). Never commit secrets.
APP_ENV=development

# Atlas free-tier (M0) connection string. The Atlas IP access list must allow your machine.
MONGODB_URI=
MONGODB_DB_NAME=building_with_rag
MONGODB_TEST_DB_NAME=building_with_rag_test

# Free Voyage keys are rate limited: Story 2.2 embedding takes about 40 minutes.
VOYAGE_API_KEY=
WEBUI_DEMO_CALLER_ID=demo-public

# Supplied by the trainer for an OpenAI-compatible LiteLLM proxy.
# Leave blank here; fill in .env only when Story 3.1 needs them.
GENERATION_API_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL_NAME=grok-4.5

RERANK_API_BASE_URL=https://api.voyageai.com/v1
RERANK_API_KEY=
RERANK_MODEL_NAME=rerank-2.5
RERANK_REQUEST_TIMEOUT_SECONDS=30
RERANK_CANDIDATE_LIMIT=20
RERANK_SEND_LIMIT=10
RERANK_RETURN_LIMIT=5
